{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "updater:default",
    "process:default",
    "log:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://pokeapi.co/*"
        },
        {
          "url": "https://*.fandom.com/*"
        },
        {
          "url": "https://bulbapedia.bulbagarden.net/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/maxiigonnzalezz/dexdeck/releases/latest"
        }
      ]
    }
  ]
}
