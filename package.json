{
  "name": "dexdeck",
  "version": "0.1.0",
  "description": "Gestor de biblioteca, enciclopedia y lanzador de fangames y ROM hacks de Pokémon.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p tests/wdio/tsconfig.json",
    "check:tests": "tsc -p tests/wdio/tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:import": "node --experimental-strip-types --import ./tests/import/register-imports.mjs --test tests/import/import-checks.test.ts",
    "test:ui": "wdio run tests/wdio/wdio.browser.conf.ts",
    "test:e2e": "wdio run tests/wdio/wdio.tauri.conf.ts",
    "test:e2e:build": "VITE_WDIO=1 tauri build --debug --no-bundle --features wdio --config src-tauri/tauri.e2e.conf.json",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-http": "~2.9.0",
    "@tauri-apps/plugin-log": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.0.0",
    "@tauri-apps/plugin-sql": "~2.6.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/mocha": "10.0.10",
    "@types/node": "26.6.6",
    "@wdio/cli": "9.31.9",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.31.9",
    "@wdio/mocha-framework": "9.31.9",
    "@wdio/native-types": "2.6.1",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.5.1",
    "@wdio/tauri-service": "1.5.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "webdriverio": "9.31.9"
  }
}
